POSTGRES_USER=dataflow
POSTGRES_PASSWORD=dataflow_dev
POSTGRES_DB=dataflow
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://dataflow:dataflow_dev@localhost:5433/dataflow
DATABASE_URL_SYNC=postgresql://dataflow:dataflow_dev@localhost:5433/dataflow

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Path to existing scrape registry JSON (read-only seed source; do not delete)
SEED_SCRAPE_DETAILS_PATH=../crawlers/mapping_files/scrape_details.json

API_HOST=0.0.0.0
API_PORT=8000

# Dashboard sessions — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-not-for-production
SESSION_HTTPS_ONLY=0
SESSION_MAX_AGE_SECONDS=604800
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Production behind https://dashboard.teamcrawlers.com (Nginx + Certbot; see deploy/):
#   SECRET_KEY=<strong random value>
#   SESSION_HTTPS_ONLY=1
#   SESSION_MAX_AGE_SECONDS=86400
#   API_HOST=127.0.0.1
# Keep :8000 off the public firewall; terminate TLS at Nginx only.

QA_STALE_HOURS=36
QA_COVERAGE_RATIO=0.5